{
}
//---------------------------------------------------------------------------
void __fastcall TForm1::ButtonDelEmplClick(TObject *Sender)
{
	if (MessageDlg("Удалить выбранного сотрудника?",mtConfirmation,TMsgDlgButtons() << mbYes << mbNo, 0) == mrYes)
	{
        try
		{
            ADOTableEmpl->Delete();
        }
        catch (Exception &e)
		{
			ShowMessage("Ошибка удаления: " + e.Message);
        }
    }
}
//---------------------------------------------------------------------------


void __fastcall TForm1::ButtonAcceptEmplClick(TObject *Sender)
{
	String sortField;
    String filterField;
    String filterText;
    String sortType;

	sortField = ComboBoxSortField->Text;

	if (sortField != "Выключено")
    {
        if (RadioButtonAsc->Checked)
            sortType = "ASC";
        else
            sortType = "DESC";

        ADOTableEmpl->Sort = sortField + " " + sortType;
    }
    else
	{
        ADOTableEmpl->Sort = "";
	}

	filterField = ComboBoxFilterField->Text;
	filterText = EditFilter->Text;

	if (filterField != "Выключено" && filterText != "")
    {
        ADOTableEmpl->Filter =
            filterField + " LIKE '%" + filterText + "%'";

        ADOTableEmpl->Filtered = true;
    }
    else
    {
        ADOTableEmpl->Filtered = false;
    }
}
//---------------------------------------------------------------------------

void __fastcall TForm1::ButtonAddEmlClick(TObject *Sender)
{
 	Form2->EditMode = false;

    Form2->EditLastName->Clear();
    Form2->EditFirstName->Clear();
    Form2->EditMiddleName->Clear();

    Form2->EditDepartmentId->Clear();
    Form2->EditPositionId->Clear();
    Form2->EditAddressId->Clear();

    Form2->ShowModal();
}
//---------------------------------------------------------------------------

void __fastcall TForm1::ButtonEditEmplClick(TObject *Sender)
{
	if (ADOTableEmpl->IsEmpty())
        return;

    Form2->EditMode = true;


    Form2->EditLastName->Text =
        ADOTableEmpl->FieldByName("last_name")->AsString;

    Form2->EditFirstName->Text =
        ADOTableEmpl->FieldByName("first_name")->AsString;

    Form2->EditMiddleName->Text =
        ADOTableEmpl->FieldByName("middle_name")->AsString;

    Form2->DateTimePickerBirthDate->Date =
        ADOTableEmpl->FieldByName("birth_date")->AsDateTime;

    Form2->EditDepartmentId->Text =
        ADOTableEmpl->FieldByName("department_id")->AsString;

    Form2->EditPositionId->Text =
        ADOTableEmpl->FieldByName("position_id")->AsString;

    Form2->EditAddressId->Text =
        ADOTableEmpl->FieldByName("address_id")->AsString;

	Form2->ShowModal();
}
