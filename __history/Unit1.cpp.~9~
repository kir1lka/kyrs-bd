void __fastcall TForm1::ButtonDelEmplClick(TObject *Sender)
{
	if (MessageDlg("”далить выбранного сотрудника?",mtConfirmation,TMsgDlgButtons() << mbYes << mbNo, 0) == mrYes)
	{
        try
		{
            ADOTableEmpl->Delete();

			ShowMessage("—отрудник удален.");
        }
        catch (Exception &e)
		{
			ShowMessage("ќшибка удалени€: " + e.Message);
        }
    }
}
