void __fastcall TForm1::ButtonDelEmplClick(TObject *Sender)
{
	if (Application->MessageBox(L"Удалить выбранного сотрудника?", L"Внимание", MB_YESNO | MB_ICONQUESTION) == mrYes)
	{
        try
		{
            ADOTableEmpl->Delete();
        }
        catch (Exception &e)
		{
			ShowMessage("Ошибка удаления: " + e.Message);
        }
    }
}
