void __fastcall TForm1::ButtonAcceptEmplClick(TObject *Sender)
{
	String sortField;
	String filterField;
	String filterText;
	String sortType;

	sortField = ComboBoxSortField->Text;

	if (sortField != "Выключено")
    {
        if (RadioButtonAsc->Checked)
            sortType = "ASC";
        else
            sortType = "DESC";

        ADOTableEmpl->Sort = sortField + " " + sortType;
    }
    else
	{
        ADOTableEmpl->Sort = "";
	}

	filterField = ComboBoxFilterField->Text;
	filterText = EditFilter->Text;

	if (filterField != "Выключено" && filterText != "")
    {
        ADOTableEmpl->Filter =
            filterField + " LIKE '%" + filterText + "%'";

        ADOTableEmpl->Filtered = true;
    }
    else
    {
        ADOTableEmpl->Filtered = false;
    }
}
