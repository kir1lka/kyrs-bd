void TForm1::LoadProjectInfo(int projectId)
{
    // ========== ЗАГРУЗКА ДАННЫХ ПРОЕКТА ==========
    // Используем ОТДЕЛЬНЫЙ query (добавь ADOQuery на форму, назови ADOQueryProject)
    ADOQueryProject->Close();
    ADOQueryProject->SQL->Clear();
    ADOQueryProject->SQL->Add("SELECT * FROM Projects WHERE id = :id");
    ADOQueryProject->Parameters->ParamByName("id")->Value = projectId;
    ADOQueryProject->Open();

    if(!ADOQueryProject->IsEmpty())
    {
        // Название проекта
        LabelName->Caption = ADOQueryProject->FieldByName("name")->AsString;

        // Даты
        String startDate = ADOQueryProject->FieldByName("start_date")->AsString;
        String endDate   = ADOQueryProject->FieldByName("end_date")->AsString;
        LabelDate->Caption = startDate + " - " + endDate;

        // Картинка — image_path хранится в Project_Participation, не в Projects!
        // Поэтому берём из ADOQueryProjectParticipation
        String basePath  = "C:\\Users\\PC\\Desktop\\бд";
        String imagePath = ADOQueryProjectParticipation->FieldByName("image_path")->AsString;
        String fullPath  = basePath + imagePath;

        if(FileExists(fullPath))
        {
            ImageProject->Picture->LoadFromFile(fullPath);
        }
        else
        {
            ImageProject->Picture->Assign(NULL); // очищаем если файл не найден
        }
    }

    // ========== ЗАГРУЗКА СОТРУДНИКОВ ==========
    MemoWorkers->Lines->Clear();
    ADOQueryWorkers->Close();
	ADOQueryWorkers->SQL->Clear();
	ADOQueryWorkers->SQL->Add(
    "SELECT e.last_name, e.firtst_name, r.name as role_name "
    "FROM Project_Participation pp "
    "INNER JOIN Employees e ON e.id = pp.employee_id "
    "INNER JOIN Roles r ON r.id = pp.role_id "
    "WHERE pp.project_id = :id");
    ADOQueryWorkers->Parameters->ParamByName("id")->Value = projectId;
    ADOQueryWorkers->Open();

	while(!ADOQueryWorkers->Eof)
	{
		String fio = ADOQueryWorkers->FieldByName("last_name")->AsString + " "
			+ ADOQueryWorkers->FieldByName("firtst_name")->AsString
			+ " (" + ADOQueryWorkers->FieldByName("role_name")->AsString + ")";
		// ВОТ ЗДЕСЬ ЗАБЫЛ ДОБАВИТЬ:
		MemoWorkers->Lines->Add(fio);  // ← этой строки нет!
		ADOQueryWorkers->Next();
	}
}

void __fastcall TForm1::DBGrid2CellClick(TColumn *Column)
{
	if(ADOQueryProjectParticipation->IsEmpty()) return;

    // Берём project_id из текущей позиции курсора
    Variant val = ADOQueryProjectParticipation->FieldByName("project_id")->Value;
    if(val.IsNull()) return;

    int projectId = (int)val;
    LoadProjectInfo(projectId);

}
