void __fastcall TForm1::DBGrid2CellClick(TColumn *Column)
{
	if (ADOTableProjecParticipation->IsEmpty()) return;

    int projectID = ADOTableProjecParticipation->FieldByName("project_id")->AsInteger;

    // Название проекта
	ADOTableProjects->Close();
    ADOTableProjects->Open();
    if (ADOTableProjects->Locate("id", Variant(projectID), TLocateOptions()))
    {
        LabelName->Caption = "Название: " + ADOTableProjects->FieldByName("name")->AsString;
    }

    // Дедлайн из текущей строки
    LabelDate->Caption = "Дедлайн: " + DateToStr(ADOTableProjecParticipation->FieldByName("deadline")->AsDateTime);

    // Изображение
    String imgPath = ADOTableProjecParticipation->FieldByName("image_path")->AsString;
    if (FileExists(imgPath))
        ImageProject->Picture->LoadFromFile(imgPath);
    else
        ImageProject->Picture = NULL;

    // Участники и роли
    String sWorkers = "";

    // Сохраняем текущую позицию
    ADOTableProjecParticipation->DisableControls();
    TBookmark bookmark = ADOTableProjecParticipation->GetBookmark();

    ADOTableProjecParticipation->First();
    while (!ADOTableProjecParticipation->Eof)
    {
        if (ADOTableProjecParticipation->FieldByName("project_id")->AsInteger == projectID)
        {
            int empID  = ADOTableProjecParticipation->FieldByName("employee_id")->AsInteger;
            int roleID = ADOTableProjecParticipation->FieldByName("role_id")->AsInteger;

            // Ищем сотрудника
            String empName = "";
            if (ADOTableEmpl->Locate("id", Variant(empID), TLocateOptions()))
            {
                empName = ADOTableEmpl->FieldByName("last_name")->AsString + " " +
                          ADOTableEmpl->FieldByName("firtst_name")->AsString;
            }

            // Ищем роль
            String roleName = "";
            ADOTableRoles->Close();
            ADOTableRoles->Open();
            if (ADOTableRoles->Locate("id", Variant(roleID), TLocateOptions()))
            {
                roleName = ADOTableRoles->FieldByName("name")->AsString;
            }

            sWorkers = sWorkers + empName + " — " + roleName + "\r\n";
        }
        ADOTableProjecParticipation->Next();
    }

    // Возвращаем позицию
    ADOTableProjecParticipation->GotoBookmark(bookmark);
    ADOTableProjecParticipation->FreeBookmark(bookmark);
    ADOTableProjecParticipation->EnableControls();

    MemoWorkers->Text = sWorkers;
}
