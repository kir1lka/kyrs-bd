void __fastcall TForm1::ExportToExcel(TADOTable *Table, const String &FileName, const String &SheetTitle)
{
    Variant Excel, Workbook, Sheet, Cell;

    try {
        Excel = Variant::CreateObject("Excel.Application");
    }
    catch (...) {
        ShowMessage("Excel не установлен на этом компьютере!");
        return;
    }

    try {
        Excel.OlePropertySet("Visible", false);

        // Создаём новую книгу
        Workbook = Excel.OlePropertyGet("Workbooks").OleFunction("Add");
        Sheet = Workbook.OlePropertyGet("Worksheets", 1);
        Sheet.OlePropertySet("Name", SheetTitle.c_str());

        // Заголовок отчёта
        Cell = Sheet.OlePropertyGet("Cells", 1, 1);
        Cell.OlePropertySet("Value", ("Отчёт: " + SheetTitle).c_str());
        Cell.OlePropertyGet("Font").OlePropertySet("Bold", true);
        Cell.OlePropertyGet("Font").OlePropertySet("Size", 14);

        Cell = Sheet.OlePropertyGet("Cells", 2, 1);
        Cell.OlePropertySet("Value", ("Дата: " + DateToStr(Date())).c_str());

        // Открываем таблицу (если ещё не открыта)
        if (!Table->Active) Table->Open();
        Table->First();

        int startRow = 4;

        // ----- Заголовки столбцов -----
        for (int i = 0; i < Table->FieldCount; i++) {
            Cell = Sheet.OlePropertyGet("Cells", startRow, i + 1);
            Cell.OlePropertySet("Value", Table->Fields->Fields[i]->FieldName.c_str());
            Cell.OlePropertyGet("Font").OlePropertySet("Bold", true);
            Cell.OlePropertyGet("Interior").OlePropertySet("Color", (int)0x00CCCCCC);
            Cell.OlePropertyGet("Borders").OlePropertySet("LineStyle", 1);
        }

        // ----- Данные -----
        int row = startRow + 1;
        while (!Table->Eof) {
            for (int i = 0; i < Table->FieldCount; i++) {
                Cell = Sheet.OlePropertyGet("Cells", row, i + 1);
                Cell.OlePropertySet("Value", Table->Fields->Fields[i]->AsString.c_str());
                Cell.OlePropertyGet("Borders").OlePropertySet("LineStyle", 1);
            }
            row++;
            Table->Next();
        }

        // ----- Итоги -----
        Cell = Sheet.OlePropertyGet("Cells", row + 1, 1);
        Cell.OlePropertySet("Value", ("Всего записей: " + IntToStr(row - startRow - 1)).c_str());
        Cell.OlePropertyGet("Font").OlePropertySet("Bold", true);

        // Автоширина столбцов
        Sheet.OlePropertyGet("Columns").OleFunction("AutoFit");

        // Сохраняем
        // xlOpenXMLWorkbook = 51 (xlsx)
        Workbook.OleProcedure("SaveAs", FileName.c_str(), 51);
        Workbook.OleProcedure("Close");
        Excel.OleProcedure("Quit");

        ShowMessage("Отчёт успешно создан:\n" + FileName);
    }
    catch (Exception &E) {
        try { Excel.OleProcedure("Quit"); } catch (...) {}
        ShowMessage("Ошибка при создании отчёта: " + E.Message);
    }
}
